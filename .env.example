# Copy to .env and fill in real values. Both are optional - see
# docker-compose.yml / README for what happens without them.

# Raises unauthenticated GitHub API rate limits for repo signal lookups
# (backend/app/services/github_client.py).
GITHUB_TOKEN=

# Enables the Phase 4 LLM deep-scan layer (backend/app/services/deep_scan.py).
# Without it, deep scans report status "failed" rather than crashing.
ANTHROPIC_API_KEY=
